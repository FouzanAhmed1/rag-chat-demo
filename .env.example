# Copy this file to .env and fill in values. Everything is optional:
# with defaults, the demo runs fully offline (hash embedder + fake LLM).

# --- Chunking ---
CHUNK_SIZE=800          # max characters per chunk
CHUNK_OVERLAP=120       # characters of overlap carried into the next chunk

# --- Retrieval ---
TOP_K=4                 # how many chunks to retrieve per question
MIN_SCORE=0.05          # minimum cosine similarity to count as relevant
# Hybrid retrieval: BM25 keyword scores are fused with vector scores using
# weighted reciprocal rank fusion. 0.0 = pure BM25, 1.0 = pure vector,
# 0.5 = even blend (default).
HYBRID_ALPHA=0.5
RRF_K=60                # reciprocal rank fusion constant
# Optional rerank stage after fusion: heuristic (default) | none
RERANKER=heuristic

# --- Embeddings ---
# EMBED_PROVIDER: hash (default, offline) | openai | sentence-transformers
EMBED_PROVIDER=hash
EMBED_DIM=1024          # vector dim for the hash embedder (1024 keeps junk queries at ~0 similarity)
# For EMBED_PROVIDER=openai (any OpenAI-compatible endpoint):
EMBED_API_KEY=
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small
# For sentence-transformers (needs: pip install sentence-transformers):
USE_SENTENCE_TRANSFORMERS=0

# --- Answer generation ---
# FAKE_LLM=1 (default): extractive offline answers, no network needed.
# Set FAKE_LLM=0 and provide LLM_API_KEY to use a real model.
FAKE_LLM=1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Conversation sessions ---
SESSION_MAX_TURNS=6      # how many turns of history to keep per session
SESSION_TTL_SECONDS=1800 # idle seconds before a session expires

# --- Storage ---
DATA_DIR=./data
SAMPLE_DOCS_DIR=./sample_docs
